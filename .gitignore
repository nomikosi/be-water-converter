# Patterns that name a directory are anchored with a leading '/'. Unanchored,
# 'build/' or 'html/' also matched any source or resource directory of that
# name, anywhere in the tree, and git would have ignored it without a word.

# Gradle
/.gradle/
/build/
/out/

# IDE downloads, caches and sandboxes of the IntelliJ Platform Gradle Plugin
/.intellijPlatform/

# IntelliJ IDEA project files: the project is imported from build.gradle
/.idea/
*.iml
*.ipr
*.iws

# Logs, such as a redirected verifyPlugin run
*.log

# Local settings and secrets
local.properties
.env
.env.*

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini
