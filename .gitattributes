# Normalize line endings: text files use LF in the repository.
* text=auto

# The Gradle wrapper script must stay LF — CRLF breaks it on Linux/macOS.
gradlew text eol=lf
*.sh    text eol=lf

# Windows batch files need CRLF.
*.bat   text eol=crlf

# Files packed into the plugin as they are, so every checkout builds the same
# plugin: a Windows clone wrote CRLF into the icons, and its build no longer
# matched the one uploaded to the Marketplace byte for byte.
*.svg   text eol=lf

# Binary files.
*.jar   binary
*.png   binary
*.zip   binary
